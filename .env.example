# ============================================================
# BUSCADOR MAX — variáveis de ambiente
# copie para .env.local e preencha com os dados do seu projeto
# ============================================================

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Opcional: usado apenas por scripts/testes fora do navegador
# e pelo webhook da Kiwify (app/api/webhook/kiwify).
# NUNCA exponha esta chave no cliente.
SUPABASE_SERVICE_ROLE_KEY=

# Kiwify (Apps > Webhooks) — token inventado por VOCÊ e cadastrado no painel.
# A URL do webhook fica: https://seu-dominio/api/webhook/kiwify?token=<este-valor>
KIWIFY_WEBHOOK_TOKEN=
